# Browser-owned state and device logs; never part of the distributable project.
/config/
/logs/
/.venv/
/node_modules/
__pycache__/
*.pyc

# Locally rebuildable DSP inputs and tool caches.
/tools/nam_js/data/*.f32
/tools/nam_js/data/*.tmp
/.dart_tool/

# Private user-owned inputs and archives; old local private directories remain ignored.
**/_LOCAL_FILES/
**/_PRIVATE/
*.dll
*.dylib
*.nam
*.clo
*.wav
*.zip
