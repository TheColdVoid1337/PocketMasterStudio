# Browser-owned state and device logs; never part of the distributable project.
/config/
/logs/
/.venv/
/node_modules/
__pycache__/
*.pyc

# Locally rebuildable DSP inputs and tool caches.
/tools/nam_js/data/*.f32
/tools/nam_js/data/*.tmp
/.dart_tool/

# Keep private user-owned inputs, scratch outputs and backups out of source control.
**/_LOCAL_FILES/
**/_PRIVATE/
**/.*_staging/
*.dll
*.dylib
*.nam
*.clo
*.wav
*.zip
*.tar.gz
